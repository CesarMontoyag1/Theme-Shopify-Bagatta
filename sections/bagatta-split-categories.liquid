{%- comment -%} Bagatta — Split sections premium (V8 - Connected to Global Theme Typography).{%- endcomment -%}

<div class="bagatta-split-categories section-{{ section.id }}">
  {% for block in section.blocks %}
    <div class="split-category-item block-{{ block.id }}" {{ block.shopify_attributes }}>
      
    {%- if block.settings.image != blank -%}
        <img src="{{ block.settings.image | image_url: width: 1500 }}" 
            alt="{{ block.settings.button_text | escape }}" 
            class="split-category-bg"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}">
    {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'split-category-bg placeholder-svg' }}
      {%- endif -%}

      <div class="split-category-content">
        {%- if block.settings.button_link != blank -%}
          <a href="{{ block.settings.button_link }}" class="bagatta-carousel__btn btn-{{ block.id }}">
            {{ block.settings.button_text }}
          </a>
        {%- else -%}
          <span class="bagatta-carousel__btn btn-{{ block.id }}">
            {{ block.settings.button_text }}
          </span>
        {%- endif -%}
      </div>
    </div>
  {% endfor %}
</div>

<style>
  /* --- CONTENEDORES PRINCIPALES --- */
  .bagatta-split-categories.section-{{ section.id }} {
    display: flex;
    flex-direction: row;
    width: 100%;
    height: {{ section.settings.desktop_height }}vh;
    min-height: 500px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  .split-category-item {
    flex: 1 1 50%;
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    text-decoration: none;
  }

  /* --- IMAGEN DE FONDO Y ANIMACIÓN --- */
  .split-category-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  
  .placeholder-svg {
    background-color: #f4f4f4;
    padding: 20px;
  }

  .split-category-item:hover .split-category-bg {
    transform: scale(1.04);
  }

  /* --- CONTENIDO Y SOMBRA INFERIOR --- */
  .split-category-content {
    position: relative;
    z-index: 2;
    padding-bottom: 8%;
    width: 100%;
    text-align: center;
    background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0) 40%);
    display: flex;
    justify-content: center;
    align-items: flex-end;
    height: 100%;
  }

  /* --- BOTÓN MEJORADO (Estilo Cristal Esmerilado) --- */
  .bagatta-carousel__btn {
    display: inline-block;
    padding: 16px 45px;
    border: 1px solid;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.3em;
    position: relative;
    z-index: 5;
    background: rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    /* Transición rápida solo en colores para evitar lag */
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    cursor: pointer;
  }

  {% for block in section.blocks %}
    /* Colores dinámicos por bloque */
    .btn-{{ block.id }} {
      border-color: {{ block.settings.color_btn_border }};
      color: {{ block.settings.color_btn_text }};
    }
    .btn-{{ block.id }}:hover {
      /* Aquí está la magia: convertimos el color sólido en un tinte traslúcido (30% opacidad) */
      background-color: {{ block.settings.color_btn_hover_bg | color_modify: 'alpha', 0.30 }} !important;
      color: {{ block.settings.color_btn_hover_text }} !important;
      border-color: {{ block.settings.color_btn_hover_bg }} !important;
    }
  {% endfor %}

  /* --- RESPONSIVE: MÓVIL --- */
  @media screen and (max-width: 768px) {
    .bagatta-split-categories.section-{{ section.id }} {
      flex-direction: column;
      height: auto;
    }
    .split-category-item {
      width: 100%;
      height: {{ section.settings.mobile_height }}vh;
      min-height: 400px;
    }
    .split-category-content {
      padding-bottom: 15%;
    }
  }
</style>

{% schema %}
{
  "name": "Bagatta Categorías Dobles",
  "max_blocks": 2,
  "settings": [
    {
      "type": "range",
      "id": "desktop_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Altura en Computadora",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Altura por bloque en Móvil",
      "default": 50
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margen Superior",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margen Inferior",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen de fondo"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Texto del Botón",
          "default": "COMPRAR AHORA"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Enlace del Botón"
        },
        {
          "type": "header",
          "content": "Colores del Botón"
        },
        {
          "type": "color",
          "id": "color_btn_text",
          "label": "Color del Texto",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "color_btn_border",
          "label": "Color del Borde",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "color_btn_hover_bg",
          "label": "Fondo al pasar el mouse (Hover)",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "color_btn_hover_text",
          "label": "Texto al pasar el mouse (Hover)",
          "default": "#000000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bagatta Categorías Dobles",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "button_text": "ROPA"
          }
        },
        {
          "type": "category",
          "settings": {
            "button_text": "BOLSOS"
          }
        }
      ]
    }
  ]
}
{% endschema %}
